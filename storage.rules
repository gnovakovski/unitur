rules_version = '2';

// Regras do Cloud Storage da Unitur (unitur-e7882.firebasestorage.app).
// Publicar: firebase deploy --only storage --project unitur-e7882
// Imagens públicas; escrita e listagem restritas à equipe ativa.
// PDFs são aceitos somente em viagens/{tripId}/{fileName}, até 20 MB.
// A conta de serviço do Storage precisa manter o papel
// "Firebase Rules Firestore Service Agent" para consultar os perfis.
service firebase.storage {
  match /b/{bucket}/o {
    function profilePath(uid) {
      return /databases/(default)/documents/users/$(uid);
    }

    function isStaff() {
      return request.auth != null
        && firestore.exists(profilePath(request.auth.uid))
        && firestore.get(profilePath(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    // Mantém as permissões existentes de imagens, leitura e exclusão.
    match /{allPaths=**} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update: if isStaff()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isStaff();
    }

    // Exceção restrita aos PDFs dos roteiros, sem liberar escrita pública.
    match /viagens/{tripId}/{fileName} {
      allow create, update: if isStaff()
        && tripId.matches('[0-9]+')
        && fileName.matches('.*[.]pdf')
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
  }
}
