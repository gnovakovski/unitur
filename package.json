{
  "name": "angular-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/rename-client-shell.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:sitemap": "node --test scripts/tests/sitemap.test.cjs",
    "serve:ssr": "node scripts/serve-ssr.mjs",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage --project demo-unitur-storage --config firebase.storage-test.json \"node --test scripts/tests/storage-rules.test.mjs\"",
    "import:wordpress-blog": "node scripts/import-wordpress-blog.mjs",
    "blog:standardize-authors": "node scripts/standardize-post-authors.mjs"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/cdk": "^21.2.10",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-server": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@angular/ssr": "^21.2.30",
    "@vercel/analytics": "2.0.1",
    "firebase": "^12.12.1",
    "ngx-image-cropper": "^9.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.26",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
